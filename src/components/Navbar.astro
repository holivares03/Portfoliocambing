---
const navLinks = [
  { labelEs: "Inicio", labelEn: "Home", href: "/" },
  { labelEs: "Proyectos", labelEn: "Projects", href: "/Proyectos" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/10">
  <nav class="max-w-5xl mx-auto px-8 py-5 flex items-center justify-between">
    <span class="text-2xl text-white tracking-wide font-family: 'Lato'">Héctor Olivares</span>
    <div class="flex items-center gap-8">
      <ul class="flex gap-8 list-none m-0 p-0">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-label-es={link.labelEs}
              data-label-en={link.labelEn}
              class={`text-sm transition-colors duration-200 no-underline pb-0.5
                ${currentPath === link.href
                  ? "text-white border-b border-white"
                  : "text-white/60 hover:text-white"
                }`}>
              {link.labelEs}
            </a>
          </li>
        ))}
      </ul>

      <!-- Botón de idioma -->
<button id="lang-toggle" class="flex items-center gap-1.5 text-xs text-white/60 hover:text-white border border-white/20 hover:border-white/50 rounded-lg px-3 py-1.5 transition-all duration-200">
  <span id="lang-label">ES</span>
</button>
    </div>
  </nav>
</header>