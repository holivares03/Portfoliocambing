---
import Layout from '../layouts/Layout.astro';

const soloProjects = [
  {
    name: "Emprender Sin limites",
    descEs: "Plataforma web desarrollada como proyecto de título universitario enfocada en conectar emprendedores con inversionistas dentro de un entorno colaborativo. El sistema permite la creación de cuentas, publicación de proyectos personales, comunitarios y empresariales, además de un sistema de inversiones y donaciones con recompensas definidas por los emprendedores. Incluye moderación basada en niveles de cuenta para gestionar el contenido dentro de la plataforma. El desarrollo fue implementado utilizando PHP para la lógica backend, MySQL para la gestión de base de datos y HTML para la estructura de la interfaz web.",
    descEn: "Web platform developed as a university capstone project focused on connecting entrepreneurs with investors within a collaborative environment. The system allows account creation, publication of personal, community, and business projects, and includes an investment and donation system with entrepreneur-defined rewards. It also implements an account-level moderation system to manage platform content. The project was built using PHP for backend logic, MySQL for database management, and HTML for the web interface structure.",
    techs: ["PHP", "HTML", "MySQL"],
    github: "https://github.com/holivares03/Emprender-sin-limites",
    image: "/projects/alpha.png",
  },
  {
    name: "TDM Webpage",
    url: "https://holivares03.github.io/TDM-webpage/",
    descEs: "Sitio web desarrollado para el torneo invitacional TDM orientado a centralizar la información del evento y visualizar datos competitivos. La plataforma integra la API de osu! para obtener información y estadísticas de jugadores, además de un sistema personalizado de fase de grupos y llaves de eliminación del torneo. También incluye secciones dedicadas al mappool, programación de partidas, información del staff y enlaces al foro oficial de osu! y redes sociales del torneo.",
    descEn: "Website developed for the TDM invitational tournament designed to centralize event information and visualize competitive data. The platform integrates the osu! API to retrieve player information and statistics, as well as a custom system for group stages and elimination brackets of the tournament. It also includes sections dedicated to the mappool, match scheduling, staff information, and links to the official osu! forum and tournament social media.",
    techs: ["Astro", "Firebase", "Tailwind"],
    github: "https://github.com/holivares03/TDM-webpage",
    image: "/projects/tdmlogo.webp",
  },
]

const collabProjects = [
  {
    name: "Psicología con bel",
    descEs: "Plataforma web desarrollada para la psicóloga Isabel Aguilar orientada a optimizar la gestión de reservas de citas mediante un sistema de agendamiento en línea. La aplicación permite a los pacientes consultar servicios y reservar horas a través de una interfaz responsive optimizada para dispositivos móviles y escritorio. El frontend fue desarrollado con React, Vite y Tailwind CSS para una interfaz moderna y eficiente. El backend fue implementado utilizando Node.js y Express, con PostgreSQL como base de datos y Prisma ORM para la gestión estructurada de la información.",
    descEn: "Web platform developed for psychologist Isabel Aguilar focused on optimizing appointment scheduling through an online booking system. The application allows patients to view services and schedule appointments through a responsive interface optimized for both mobile and desktop devices. The frontend was built using React, Vite, and Tailwind CSS for a modern and efficient interface. The backend was implemented with Node.js and Express, using PostgreSQL as the database and Prisma ORM for structured data management.",
    techs: ["React", "Vite", "Tailwind", "Node.js", "Express", "PostgreSQL", "Prisma"],
    github: "https://github.com/tu-usuario/proyecto-gamma",
    image: "/projects/psicologialogo.png",
    collaborators: ["Tomás González", "Bastián Colignon"],
  },
]
---

<Layout>
  <section class="min-h-screen flex flex-col items-center px-6 pt-6 pb-12 opacity-0" id="projects-section">

    <!-- Tabs -->
    <div class="flex gap-2 mb-12 border border-white/10 rounded-2xl p-1">
      <button
        id="tab-solo"
        data-i18n="solo"
        onclick="switchTab('solo')"
        class="tab-btn active-tab px-6 py-2 rounded-xl text-sm transition-all duration-200">
        Personales
      </button>
      <button
        id="tab-collab"
        data-i18n="collab"
        onclick="switchTab('collab')"
        class="tab-btn px-6 py-2 rounded-xl text-sm transition-all duration-200 text-white/50 hover:text-white">
        Colaborativos
      </button>
    </div>

    <!-- Lista solo -->
    <div id="list-solo" class="w-full max-w-4xl flex flex-col gap-6">
      {soloProjects.map((p) => (
        <div class="project-card flex gap-5 border border-white/10 rounded-2xl p-5 hover:border-white/25 transition-all duration-200 bg-white/5 backdrop-blur-sm">
          <!-- Imagen -->
          <div class="w-28 h-28 rounded-xl overflow-hidden shrink-0 bg-white/5 border border-white/10">
            {p.image
              ? <img src={p.image} alt={p.name} class="w-full h-full object-cover" />
              : <div class="w-full h-full flex items-center justify-center text-white/20 text-xs">sin imagen</div>
            }
          </div>

          <!-- Info -->
          <div class="flex flex-col justify-between flex-1 min-w-0">
            <div>
              <h2 class="text-white text-base font-medium mb-1">
                {p.url
                ? <a href={p.url} target="_blank" class="hover:underline underline-offset-4 decoration-white/30 transition-all duration-200">
                  {p.name}
                  </a>
                : p.name
                }
              </h2>
              <p class="text-white/55 text-sm leading-relaxed" data-desc-es={p.descEs} data-desc-en={p.descEn}>
                {p.descEs}
              </p>
            </div>

            <div class="flex items-center justify-between mt-3 flex-wrap gap-2">
              <!-- Tecnologías -->
              <div class="flex gap-1.5 flex-wrap">
                {p.techs.map(t => (
                  <span class="text-xs px-2 py-0.5 rounded-lg border border-white/15 text-white/50">
                    {t}
                  </span>
                ))}
              </div>

              <!-- GitHub -->
              <a href={p.github} target="_blank"
                class="flex items-center gap-1.5 text-xs text-white/50 hover:text-white border border-white/15 hover:border-white/40 rounded-lg px-3 py-1.5 transition-all duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                </svg>
                <span data-i18n="viewGithub">Ver en GitHub</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Lista collab -->
    <div id="list-collab" class="w-full max-w-4xl flex-col gap-6 hidden">
      {collabProjects.map((p) => (
        <div class="project-card flex gap-5 border border-white/10 rounded-2xl p-5 hover:border-white/25 transition-all duration-200 bg-white/5 backdrop-blur-sm">
          <div class="w-28 h-28 rounded-xl overflow-hidden shrink-0 bg-white/5 border border-white/10">
            {p.image
              ? <img src={p.image} alt={p.name} class="w-full h-full object-cover" />
              : <div class="w-full h-full flex items-center justify-center text-white/20 text-xs">sin imagen</div>
            }
          </div>

          <div class="flex flex-col justify-between flex-1 min-w-0">
            <div>
              <h2 class="text-white text-base font-medium mb-1">{p.name}</h2>
              <p class="text-white/55 text-sm leading-relaxed" data-desc-es={p.descEs} data-desc-en={p.descEn}>
                {p.descEs}
              </p>
              <!-- Colaboradores -->
              <div class="flex gap-1.5 mt-2 flex-wrap">
                {p.collaborators.map(c => (
                  <span class="text-xs px-2 py-0.5 rounded-lg bg-white/5 border border-white/10 text-white/40">
                    👤 {c}
                  </span>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-between mt-3 flex-wrap gap-2">
              <div class="flex gap-1.5 flex-wrap">
                {p.techs.map(t => (
                  <span class="text-xs px-2 py-0.5 rounded-lg border border-white/15 text-white/50">
                    {t}
                  </span>
                ))}
              </div>
              <a href={p.github} target="_blank"
                class="flex items-center gap-1.5 text-xs text-white/50 hover:text-white border border-white/15 hover:border-white/40 rounded-lg px-3 py-1.5 transition-all duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                </svg>
                <span data-i18n="viewGithub">Ver en GitHub</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>
</Layout>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  #projects-section {
    animation: fadeIn 0.9s ease forwards;
    animation-delay: 0.2s;
  }
  .active-tab {
    background: rgba(255,255,255,0.1);
    color: white;
  }
</style>

<script>
  function triggerPageAnimation() {
    const section = document.getElementById('projects-section')!
    section.style.animation = 'none'
    section.style.opacity = '0'
    void section.offsetHeight
    section.style.animation = ''
  }

  function switchTab(tab: string) {
    const solo = document.getElementById('list-solo')!
    const collab = document.getElementById('list-collab')!
    const btnSolo = document.getElementById('tab-solo')!
    const btnCollab = document.getElementById('tab-collab')!

    if (tab === 'solo') {
      solo.classList.remove('hidden')
      solo.classList.add('flex')
      collab.classList.add('hidden')
      collab.classList.remove('flex')
      btnSolo.classList.add('active-tab')
      btnCollab.classList.remove('active-tab')
      btnCollab.classList.add('text-white/50')
    } else {
      collab.classList.remove('hidden')
      collab.classList.add('flex')
      solo.classList.add('hidden')
      solo.classList.remove('flex')
      btnCollab.classList.add('active-tab')
      btnSolo.classList.remove('active-tab')
      btnSolo.classList.add('text-white/50')
    }
  }

  (window as any).switchTab = switchTab

  document.addEventListener('DOMContentLoaded', () => {
    const lang = localStorage.getItem('lang') || 'es'
    document.querySelectorAll<HTMLElement>('[data-desc-es]').forEach(el => {
      el.textContent = lang === 'es' ? el.dataset.descEs! : el.dataset.descEn!
    })

    // Escucha cambios de idioma desde el botón del navbar
    document.getElementById('lang-toggle')?.addEventListener('click', () => {
      setTimeout(() => {
        const newLang = localStorage.getItem('lang') || 'es'
        document.querySelectorAll<HTMLElement>('[data-desc-es]').forEach(el => {
          el.textContent = newLang === 'es' ? el.dataset.descEs! : el.dataset.descEn!
        })
        triggerPageAnimation()
      }, 10)
    })
  })
</script>